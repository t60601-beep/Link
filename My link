            z-index: 10;
        }

        .info-layout-table {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            border-top: 2px solid var(--ink-black);
            padding-top: 15px;
            margin-bottom: 18px;
        }

        .table-cell .cell-title {
