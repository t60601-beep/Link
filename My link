        }

        .board-main-title p {
            font-size: 0.85rem;
            color: #8c817e;
            margin-top: 3px;
        }

        /* �명룷洹몃옒�� �쒓컙�� 而⑦뀒�대꼫 */
        .timeline-scroller {
            margin: 22px 0;
            display: flex;
            flex-direction: column;
            gap: 13px;
            flex-grow: 1;
            justify-content: center;
        }

        .timeline-item-strip {
