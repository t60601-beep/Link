    <style>
        :root {
            --bg-deep: #0b0908;
            --poster-cream: #f4ede2;
            --blossom-pink: #ffb1bf;
            --shadow-rose: #e59ba8;
            --ink-black: #1c1615;
            --stem-olive: #cbd6cd;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-deep);
            font-family: 'Noto Serif KR', serif;
            -webkit-font-smoothing: antialiased;
        }

        /* 3D �곹솕�� GUI 媛��� 酉고룷�� */
        .perspective-viewport {
            width: 100%;
            height: 100%;
            perspective: 2000px;
            position: relative;
        }

        /* �곹샇�묒슜 泥댁씤�� 嫄몃━�� GUI 臾대튃 而⑦뀒�대꼫 */
        .gui-motion-stage {
            width: 100%;
            height: 100%;
            position: absolute;
            transform-style: preserve-3d;
            transition: transform 1.4s cubic-bezier(0.76, 0, 0.24, 1);
        }

        /* [GUI �대룞 紐낆꽭] 3D �뚯쟾怨� �먭렐 �섏텞�� 寃고빀�� �꾨꼍�� �붾㈃ �꾪솚 �곹깭 */
        .gui-motion-stage.shifted {
            transform: translateZ(-400px) rotateX(95deg) translateY(-50%);
        }

        .screen {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            backface-visibility: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* ==========================================
           SCREEN 1: 由ъ뼹 �덉씠�대뱶 �붿옄�� �꾪듃 �ъ뒪��
        ========================================== */
        .poster-screen {
            background: linear-gradient(135deg, #161211 0%, #0d0a09 100%);
        }

        .poster-canvas {
            width: 100%;
            max-width: 510px;
            height: 100%;
            max-height: 840px;
            background-color: var(--poster-cream);
            box-shadow: 0 45px 100px rgba(0,0,0,0.5), inset 0 0 40px rgba(0,0,0,0.02);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 42px 34px;
            border: 1px solid rgba(255,255,255,0.03);
        }

        /* �덉씠�대뱶 �꾨갑媛�瑜대뱶 �곗텧�� �꾪븳 諛깃렇�쇱슫�� 嫄곕� ���댄룷 */
        .bg-giant-typography {
            position: absolute;
            font-family: 'Cinzel', serif;
            font-size: 15rem;
            font-weight: 900;
            color: rgba(255, 177, 191, 0.12);
            line-height: 0.7;
            top: 8%;
            right: -15%;
            user-select: none;
            pointer-events: none;
            z-index: 1;
        }

        .poster-top-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1.5px solid var(--ink-black);
            padding-bottom: 10px;
            z-index: 10;
        }

        .meta-count {
            font-size: 0.75rem;
            font-weight: 900;
            letter-spacing: 0.3rem;
            color: var(--ink-black);
        }

        .meta-season {
            font-family: 'Cinzel', serif;
            font-size: 0.9rem;
            font-weight: 900;
            color: var(--shadow-rose);
            letter-spacing: 0.1rem;
        }

        /* �� 珥덇퀬怨좊룄 �덉씠�대뱶 �ㅻ쾭�� �듭떖 援ъ뿭 */
        .overlap-art-matrix {
            position: relative;
            width: 100%;
            height: 410px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 15px 0;
        }

        /* 寃뱀묠 �덉씠�� 1: 湲고븯�� 異붿긽 而щ윭 移� 諛곗튂 */
        .geo-layer-pink-circle {
            position: absolute;
            width: 270px;
            height: 270px;
            background: linear-gradient(135deg, #fff2f4 0%, var(--blossom-pink) 100%);
            border-radius: 50%;
            z-index: 2;
            top: 12%;
            left: 6%;
            filter: blur(1px);
        }

        .geo-layer-olive-bar {
            position: absolute;
            width: 150px;
            height: 290px;
            background-color: var(--stem-olive);
            border-radius: 80px;
            transform: rotate(-38deg);
            z-index: 2;
            bottom: 4%;
            right: 5%;
            opacity: 0.7;
        }

        /* 寃뱀묠 �덉씠�� 2: �쇰윭�ㅽ듃 �ㅼ뿉 ��諛��섍쾶 源붾━�� 珥덈��� �몃━�� 硫붿씤 �띿뒪�� */
        .layered-text-base {
            position: absolute;
            width: 100%;
            text-align: center;
            z-index: 3;
            pointer-events: none;
        }

        .layered-text-base .slogan-sub {
            font-size: 1.05rem;
            font-weight: 300;
            letter-spacing: 0.6rem;
            color: #5c5250;
            margin-bottom: 4px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.03);
        }

        .layered-text-base .brand-main {
            font-size: 4.3rem;
            font-weight: 900;
            line-height: 5rem;
            color: var(--ink-black);
            letter-spacing: -0.05rem;
        }

        /* 寃뱀묠 �덉씠�� 3: 湲��� �쒓��대뜲瑜� �リ퀬 �섏� �꾨㈃�� �꾩쟾�� 援먯감�섎뒗 踰싰퐙 �섎Т 媛�吏� SVG */
        .layered-svg-overlay {
            position: absolute;
            width: 360px;
            height: 360px;
            z-index: 4;
            transform: rotate(-7deg) translateY(15px);
            filter: drop-shadow(10px 25px 35px rgba(229, 155, 168, 0.35));
            pointer-events: none;
