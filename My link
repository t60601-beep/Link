        /* ==========================================
           SCREEN 2: �묐갑�� 留곹겕�� 異뺤젣 �명룷 GUI 蹂대뱶
        ========================================== */
        .detail-screen {
            background-color: #120f0e;
            transform: rotateX(-90deg) translateZ(420px); /* 3D �뺤쑁硫댁껜 濡� �덉씪 �쒕툕�ㅽ겕由� 諛곗튂 */
        }

        .detail-board-shell {
