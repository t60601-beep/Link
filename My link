<style id="extra-animations">
/* ===== �ъ뒪�� �낆옣 �좊땲硫붿씠�� ===== */
.poster-canvas {
    animation: posterEnter 1s cubic-bezier(.22,1,.36,1) both;
}

@keyframes posterEnter {
    from {
        opacity: 0;
        transform: translateY(28px) scale(.96);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* �곷떒 �뺣낫媛� �쒖꽌��濡� �섑��� */
.poster-top-meta {
    animation: fadeSlideDown .8s .2s ease both;
}

.overlap-art-matrix {
    animation: artReveal 1.2s .35s cubic-bezier(.22,1,.36,1) both;
}

.astro-science-strip {
    animation: fadeSlideUp .8s .65s ease both;
}

.poster-bottom-housing {
    animation: fadeSlideUp .8s .8s ease both;
}

@keyframes fadeSlideDown {
    from { opacity: 0; transform: translateY(-16px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes artReveal {
    from {
        opacity: 0;
        transform: scale(.82) rotate(-4deg);
    }
    to {
        opacity: 1;
        transform: scale(1) rotate(0);
    }
}

/* 湲고븯�� �붿냼�� �먮┛ ��吏곸엫 */
.geo-layer-pink-circle {
    animation: circleFloat 5s ease-in-out infinite alternate;
}

.geo-layer-olive-bar {
    animation: barFloat 6s ease-in-out infinite alternate;
}

@keyframes circleFloat {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(8px, -10px) scale(1.035); }
}

@keyframes barFloat {
    from { transform: rotate(-38deg) translate(0, 0); }
    to { transform: rotate(-34deg) translate(-6px, 8px); }
}

/* 踰싰퐙 �섎춪媛�吏�媛� �꾩＜ �댁쭩 �붾뱾由� */
.layered-svg-overlay {
    animation: branchSway 5s ease-in-out infinite alternate;
}

@keyframes branchSway {
    from { transform: rotate(-7deg) translateY(15px); }
    to { transform: rotate(-4deg) translateY(11px); }
}

/* 踰꾪듉�� ������ 媛뺤“ �④낵 */
.btn-action-gate {
    animation: buttonPulse 3s 2s ease-in-out infinite;
}

@keyframes buttonPulse {
    0%, 70%, 100% { transform: scale(1); }
    80% { transform: scale(1.018); }
    85% { transform: scale(1); }
}

/* �곸꽭 �붾㈃ �깆옣 �붿냼 */
.detail-board-shell {
    animation: detailEnter .9s cubic-bezier(.22,1,.36,1) both;
}

@keyframes detailEnter {
    from {
        opacity: 0;
        transform: translateY(25px) scale(.97);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.timeline-item-strip {
    animation: timelineIn .65s ease both;
}

.timeline-item-strip:nth-child(1) { animation-delay: .15s; }
.timeline-item-strip:nth-child(2) { animation-delay: .25s; }
.timeline-item-strip:nth-child(3) { animation-delay: .35s; }
.timeline-item-strip:nth-child(4) { animation-delay: .45s; }

@keyframes timelineIn {
    from {
        opacity: 0;
        transform: translateX(25px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
