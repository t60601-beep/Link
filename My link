            color: var(--ink-black);
            line-height: 1.4;
        }

        /* �섏씠�붾뱶 �≪뀡 踰꾪듉 */
        .btn-action-gate {
            width: 100%;
            background-color: var(--ink-black);
            color: var(--poster-cream);
