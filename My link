            transition: all 0.3s ease;
        }

        .btn-return-gate:hover {
            background: rgba(255, 177, 191, 0.08);
            letter-spacing: 0.08rem;
        }

        /* 紐⑤컮�� 移쒗솕�� �먯뿰�ㅻ윭�� 踰싰퐙�� �④낵 */
.canvas-petal {
    position: absolute;
    top: -30px;
    left: 0;
    width: 12px;
    height: 9px;
    background: linear-gradient(135deg, #fff7f8 0%, #ffb1bf 65%, #e59ba8 100%);
